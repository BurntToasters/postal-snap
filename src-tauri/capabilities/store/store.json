{
  "$schema": "../../gen/schemas/desktop-schema.json",
  "identifier": "store",
  "description": "Postal Snap Store permissions without self-update commands.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "deep-link:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "http://*" }, { "url": "https://*" }]
    },
    "notification:default"
  ]
}
