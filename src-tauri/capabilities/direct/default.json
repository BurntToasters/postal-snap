{
  "$schema": "../../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for direct Postal Snap builds.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "deep-link:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "http://*" }, { "url": "https://*" }]
    },
    "notification:default",
    "process:default",
    "updater:default"
  ]
}
