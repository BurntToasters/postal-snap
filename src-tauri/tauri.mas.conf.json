{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "macOSPrivateApi": false,
    "security": { "capabilities": ["store"] },
    "windows": [
      {
        "label": "main",
        "title": "Postal Snap",
        "width": 1240,
        "height": 820,
        "minWidth": 620,
        "minHeight": 540,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "create": false
      }
    ]
  },
  "bundle": {
    "targets": ["app"],
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "14.0",
      "entitlements": "entitlements.mas.plist",
      "signingIdentity": null
    }
  },
  "plugins": { "updater": null }
}
