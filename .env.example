# Postal Snap release environment
# Copy to .env. Never commit real credentials, private keys, passwords, or test accounts.

# GitHub releases use the GitHub CLI credential store. Authenticate this VM with
# `gh auth login` before running release commands; no GitHub token belongs here.

# Detached GPG artifact signatures. GPG_KEY_ID is recommended when more than one
# secret key is installed. Leave GPG_PASSPHRASE blank to use the local gpg-agent;
# set it only in encrypted CI secrets for non-interactive signing.
GPG_KEY_ID=
GPG_PASSPHRASE=
# Base64-encoded exported secret key for GitHub Actions only. Local releases use
# the installed GPG keyring and may leave this blank.
GPG_PRIVATE_KEY_BASE64=

# Tauri updater signing, generated with `npm run tauri -- signer generate`.
# The private key and password sign updater payloads. The public key must match
# plugins.updater.pubkey in src-tauri/tauri.conf.json and is embedded into
# direct builds. Store builds do not initialize the Tauri updater.
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=
TAURI_UPDATER_PUBLIC_KEY=

# Windows direct-download Authenticode signing.
# Use the SHA-1 certificate thumbprint without spaces. The certificate must be in
# CurrentUser\My and contain its private key. The PFX values are CI-only helpers
# that import such a certificate and derive/verify the thumbprint.
WINDOWS_CERTIFICATE_THUMBPRINT=
WINDOWS_TIMESTAMP_URL=http://timestamp.digicert.com
WINDOWS_CERTIFICATE_PFX_BASE64=
WINDOWS_CERTIFICATE_PASSWORD=

# Microsoft Store Partner Center identity. Copy these exact values from the
# product identity page; Store submission performs the final package signing.
MSSTORE_IDENTITY_NAME=
MSSTORE_PUBLISHER=
MSSTORE_PUBLISHER_DISPLAY_NAME=

# Direct macOS Developer ID signing and notarization.
# APPLE_SIGNING_IDENTITY example: Developer ID Application: Name (TEAMID)
APPLE_SIGNING_IDENTITY=
APPLE_TEAM_ID=

# Notarization option A: App Store Connect API key.
# APPLE_API_KEY is the key ID; APPLE_API_KEY_PATH points to its .p8 file.
APPLE_API_KEY=
APPLE_API_ISSUER=
APPLE_API_KEY_PATH=

# Notarization/upload option B: Apple ID plus app-specific password.
# APPLE_APP_SPECIFIC_PASSWORD is accepted as a legacy alias for APPLE_PASSWORD.
APPLE_ID=
APPLE_PASSWORD=

# Mac App Store packaging.
# APPLE_INSTALLER_IDENTITY example: 3rd Party Mac Developer Installer: Name (TEAMID)
# MAS_PROVISIONING_PROFILE may be absolute or relative to this repository.
# Increment MAS_BUILD_NUMBER for every App Store Connect upload.
APPLE_INSTALLER_IDENTITY=
MAS_PROVISIONING_PROFILE=
MAS_BUILD_NUMBER=1

# CI-only macOS certificate import. APPLE_CERTIFICATE_P12_BASE64 may contain the
# application and installer identities or the workflow may import them separately.
APPLE_CERTIFICATE_P12_BASE64=
APPLE_CERTIFICATE_PASSWORD=
APPLE_KEYCHAIN_PASSWORD=

# Optional local/SSH Mac login-keychain unlock used by `npm run mac:ssh:keychain`.
MAC_KEYCHAIN_PASSWORD=

# Dedicated iCloud smoke-test account. Use an app-specific password, never the
# Apple Account password. `npm run test:icloud` loads these from .env.
POSTAL_SNAP_TEST_ICLOUD_EMAIL=
POSTAL_SNAP_TEST_ICLOUD_PASSWORD=

# Recovery only. Exact value 1 permits release scripts to use a dirty worktree.
# Normal releases must leave this at 0.
ALLOW_DIRTY_RELEASE=0
